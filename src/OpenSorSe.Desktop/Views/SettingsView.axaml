<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSorSe.Desktop.ViewModels"
             xmlns:views="using:OpenSorSe.Desktop.Views"
             x:Class="OpenSorSe.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer x:Name="SettingsScrollViewer">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="3">
                    <TextBlock Classes="page-title" Text="Settings" />
                    <TextBlock Classes="page-subtitle" Text="Make OpenSorSe yours." />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="help"
                        Content="?"
                        Command="{Binding HelpCommand}"
                        ToolTip.Tip="Open Settings help"
                        AutomationProperties.Name="Help for Settings" />
            </Grid>

            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="General settings" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Keep completed scan information locally"
                              IsChecked="{Binding Draft.CatalogEnabled, Mode=TwoWay}" />
                    <TextBlock Text="Off by default. Saved scans keep display-safe information and accepted tags in OpenSorSe application data; selected files are never changed."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card"
                    IsVisible="{Binding HasPlatformDiagnostics}">
                <StackPanel DataContext="{Binding PlatformDiagnostics}" Spacing="8">
                    <TextBlock Text="Platform diagnostics" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Support is capability-specific. Limited or unavailable features remain disabled or fail closed with an explanation."
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="4">
                        <TextBlock Text="Operating system" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Architecture" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Architecture}" />
                        <TextBlock Grid.Row="2" Text="Runtime" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Runtime}" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="Application-owned locations" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ApplicationLocations}"
                               FontFamily="Consolas, monospace"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LinkPolicy}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Capabilities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlatformCapabilityPresentation">
                                <Grid ColumnDefinitions="180,180,*" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding Capability}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding State}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Explanation}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <Button Margin="0,0,8,8"
                                Content="Copy platform report"
                                Command="{Binding CopyReportCommand}" />
                        <Button Margin="0,0,8,8"
                                Content="Open diagnostics folder"
                                Command="{Binding OpenDiagnosticsFolderCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Background indexing" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Build Search coverage gradually in the background"
                              IsChecked="{Binding Draft.DeepIndexingEnabled, Mode=TwoWay}" />
                    <TextBlock Text="Basic stores names and metadata. Standard adds document text and related concepts. Deep adds applicable OCR and richer bounded analysis. Completed stages resume after interruption."
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Default indexing level" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AvailableIndexingLevels}"
                                      SelectedItem="{Binding Draft.DefaultIndexingLevel, Mode=TwoWay}"
                                      AutomationProperties.Name="Default indexing level" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Resource mode" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AvailableIndexingResourceModes}"
                                      SelectedItem="{Binding Draft.IndexingResourceMode, Mode=TwoWay}"
                                      AutomationProperties.Name="Background indexing resource mode" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="Maximum index size (MiB)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumIndexSizeMiB, Mode=TwoWay}"
                                     AutomationProperties.Name="Maximum index size" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel>
                        <CheckBox Margin="0,0,16,6"
                                  Content="Enable OCR stages"
                                  IsChecked="{Binding Draft.DeepOcrProcessingEnabled, Mode=TwoWay}" />
                        <CheckBox Margin="0,0,16,6"
                                  Content="Enable optional local AI stages"
                                  IsChecked="{Binding Draft.DeepAiProcessingEnabled, Mode=TwoWay}" />
                        <CheckBox Margin="0,0,16,6"
                                  Content="Exclude generated folders"
                                  IsChecked="{Binding Draft.ExcludeGeneratedFolders, Mode=TwoWay}" />
                        <CheckBox Margin="0,0,16,6"
                                  Content="Keep binaries and executables metadata-only"
                                  IsChecked="{Binding Draft.BinaryAndExecutableMetadataOnly, Mode=TwoWay}" />
                        <CheckBox Margin="0,0,16,6"
                                  Content="Index archive contents"
                                  IsChecked="{Binding Draft.ArchiveIndexingEnabled, Mode=TwoWay}" />
                    </WrapPanel>
                    <Grid IsVisible="{Binding IsAdvancedSettingsVisible}"
                          ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="8"
                          RowSpacing="6">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Maximum workers" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumIndexingConcurrency, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Maximum retries" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumIndexingRetryCount, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="Maximum chunks per document" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumSemanticChunksPerDocument, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Text="Maximum document text characters" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumExtractedTextCharacters, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="Maximum OCR text characters" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumDeepOcrTextCharacters, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3">
                            <TextBlock Text="Deleted records retained (days)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.DeletedFileRetentionDays, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="3">
                            <TextBlock Text="Failed history retained (days)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.FailedJobHistoryRetentionDays, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                            <CheckBox Content="Only while idle, where supported"
                                      IsChecked="{Binding Draft.ProcessIndexOnlyWhileIdle, Mode=TwoWay}" />
                            <CheckBox Content="Only while connected to power, where supported"
                                      IsChecked="{Binding Draft.ProcessIndexOnlyOnPower, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="3">
                            <CheckBox Content="Pause below a battery threshold, where supported"
                                      IsChecked="{Binding Draft.PauseIndexingOnLowBattery, Mode=TwoWay}" />
                            <TextBox Text="{Binding Draft.PauseBelowBatteryPercentage, Mode=TwoWay}"
                                     IsEnabled="{Binding Draft.PauseIndexingOnLowBattery}"
                                     AutomationProperties.Name="Battery pause threshold percentage" />
                        </StackPanel>
                    </Grid>
                    <Grid IsVisible="{Binding IsAdvancedSettingsVisible}"
                          ColumnDefinitions="Auto,*,*"
                          ColumnSpacing="8">
                        <CheckBox Content="Use a local processing time window"
                                  IsChecked="{Binding Draft.UseIndexingTimeWindow, Mode=TwoWay}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Draft.IndexingWindowStartHour, Mode=TwoWay}"
                                 IsEnabled="{Binding Draft.UseIndexingTimeWindow}"
                                 PlaceholderText="Start hour 0–23"
                                 AutomationProperties.Name="Indexing window start hour" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding Draft.IndexingWindowEndHour, Mode=TwoWay}"
                                 IsEnabled="{Binding Draft.UseIndexingTimeWindow}"
                                 PlaceholderText="End hour 0–23"
                                 AutomationProperties.Name="Indexing window end hour" />
                    </Grid>
                    <TextBlock Text="Idle, power, and battery controls use platform signals only when available; unsupported controls degrade safely without blocking Search."
                               IsVisible="{Binding IsAdvancedSettingsVisible}"
                               TextWrapping="Wrap"
                               Classes="page-subtitle" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="7">
                    <TextBlock Text="Search" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Enable local Search"
                              IsChecked="{Binding Draft.SemanticSearchEnabled, Mode=TwoWay}" />
                    <TextBlock Text="Uses a local index over names, folders, metadata, document text, OCR, tags, and related concepts. Search remains useful while background coverage is still being built."
                               TextWrapping="Wrap" />
                    <Grid IsVisible="{Binding IsAdvancedSettingsVisible}"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Maximum indexed documents" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumSemanticDocuments, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Maximum displayed results" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumSemanticResults, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Text Recognition (Beta)" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Extract bounded document metadata and native text"
                              IsChecked="{Binding Draft.MetadataExtractionEnabled, Mode=TwoWay}" />
                    <CheckBox Content="Enable local OCR"
                              IsChecked="{Binding Draft.OcrEnabled, Mode=TwoWay}" />
                    <CheckBox Content="OCR only when reliable native text is unavailable"
                              IsChecked="{Binding Draft.OcrOnlyWhenNativeTextUnavailable, Mode=TwoWay}" />
                    <TextBlock Text="OCR is off by default, remains local, and never writes recognized text into source documents. OpenSorSe includes a local PDF page renderer; recognition requires an externally managed Tesseract CLI and selected language packs."
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Maximum pages per document" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumOcrPages, Mode=TwoWay}"
                                     AutomationProperties.Name="Maximum OCR pages" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Maximum file size (MiB)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumContentFileSizeMiB, Mode=TwoWay}"
                                     AutomationProperties.Name="Maximum content file size" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Text="OCR language" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.OcrLanguage, Mode=TwoWay}"
                                     PlaceholderText="eng, deu, or eng+deu"
                                     AutomationProperties.Name="OCR language" />
                            <TextBlock Text="Use eng, deu, or eng+deu. Recheck after installing language packs."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="Maximum OCR duration (seconds)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumOcrDurationSeconds, Mode=TwoWay}"
                                     AutomationProperties.Name="Maximum OCR duration" />
                        </StackPanel>
                        <CheckBox Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  IsVisible="{Binding IsAdvancedSettingsVisible}"
                                  Content="Allow bounded content processing in the background"
                                  IsChecked="{Binding Draft.BackgroundContentProcessingEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid IsVisible="{Binding IsAdvancedSettingsVisible}"
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="8"
                          RowSpacing="6">
                        <StackPanel Spacing="3">
                            <TextBlock Text="PDF rasterization DPI" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.PdfRasterizationDpi, Mode=TwoWay}"
                                     AutomationProperties.Name="PDF rasterization DPI" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Maximum rendered edge (pixels)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumRasterDimension, Mode=TwoWay}"
                                     AutomationProperties.Name="Maximum rendered PDF page edge" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Text="Maximum OCR text characters" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumOcrTextCharacters, Mode=TwoWay}"
                                     AutomationProperties.Name="Maximum OCR text characters" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="Temporary image budget (MiB)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.MaximumTemporaryStorageMiB, Mode=TwoWay}"
                                     AutomationProperties.Name="Temporary OCR image budget" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="3">
                            <TextBlock Text="Tesseract executable (optional)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.TesseractExecutablePath, Mode=TwoWay}"
                                     PlaceholderText="Leave blank to use tesseract from PATH"
                                     AutomationProperties.Name="Optional Tesseract executable path" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel>
                        <Button Margin="0,0,8,8"
                                Classes="secondary"
                                Content="Check Text Recognition"
                                Command="{Binding CheckOcrCapabilityCommand}" />
                        <Button Margin="0,0,8,8"
                                Content="Clear cache / reprocess next scan"
                                Command="{Binding RequestContentCacheResetCommand}" />
                        <Button Margin="0,0,8,8"
                                IsVisible="{Binding IsContentCacheResetPending}"
                                Content="Confirm clear"
                                Command="{Binding ConfirmContentCacheResetCommand}" />
                        <Button Margin="0,0,8,8"
                                IsVisible="{Binding IsContentCacheResetPending}"
                                Content="Cancel"
                                Command="{Binding CancelContentCacheResetCommand}" />
                    </WrapPanel>
                    <views:StatusBanner DataContext="{Binding ContentStatus}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Optional AI assistance" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Enable AI features"
                              IsChecked="{Binding Draft.AiEnabled, Mode=TwoWay}" />
                    <TextBlock Text="Off by default. When disabled, OpenSorSe hides AI actions and does not check Ollama, discover models, or send model requests."
                               TextWrapping="Wrap" />

                    <StackPanel IsVisible="{Binding IsAiCapabilitySettingsVisible}" Spacing="8">
                        <TextBlock Text="File Assistant setup" FontWeight="SemiBold" />
                        <StackPanel IsVisible="{Binding IsAdvancedSettingsVisible}" Spacing="4">
                            <TextBlock Text="Ollama endpoint" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.AiEndpoint, Mode=TwoWay}"
                                     ToolTip.Tip="Default: http://127.0.0.1:11434"
                                     AutomationProperties.Name="Ollama endpoint" />
                        </StackPanel>

                        <WrapPanel>
                            <Button Margin="0,0,8,8"
                                    Classes="primary"
                                    Content="Retry connection"
                                    Command="{Binding RetryAiConnectionCommand}" />
                            <Button Margin="0,0,8,8"
                                    Classes="secondary"
                                    Content="Refresh installed models"
                                    Command="{Binding DiscoverAiModelsCommand}" />
                            <Button Margin="0,0,8,8"
                                    IsVisible="{Binding IsAiBusy}"
                                    Classes="secondary"
                                    Content="Cancel"
                                    Command="{Binding CancelAiOperationCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding AiReadinessText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <views:StatusBanner DataContext="{Binding AiStatus}" />

                        <TextBlock Text="Installed model" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableAiModels}"
                                  SelectedItem="{Binding Draft.SelectedAiModel, Mode=TwoWay}"
                                  PlaceholderText="Discover models, then select one"
                                  AutomationProperties.Name="Installed Ollama model" />
                        <TextBlock IsVisible="{Binding HasNoDiscoveredModels}"
                                   Text="No installed models have been discovered yet. Install a model in Ollama, then refresh models."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedModelStatusText}" TextWrapping="Wrap" />

                        <StackPanel IsVisible="{Binding IsAdvancedSettingsVisible}" Spacing="4">
                            <TextBlock Text="Request timeout (seconds)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Draft.AiRequestTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="AI request timeout in seconds" />
                            <TextBlock Text="{Binding AiRequestTimeoutValidation}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="AI capabilities" FontWeight="SemiBold" />
                        <CheckBox Content="Enable file rename suggestions"
                                  IsChecked="{Binding Draft.FileRenameSuggestionsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="Enable folder structure suggestions"
                                  IsChecked="{Binding Draft.FolderStructureSuggestionsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="Allow local AI to analyze extracted document text"
                                  IsChecked="{Binding Draft.DocumentTextInterpretationEnabled, Mode=TwoWay}" />
                        <TextBlock Text="This separate switch is off by default. When enabled, an explicit interpretation request may send bounded extracted native/OCR text to the configured endpoint. Non-local endpoints receive that text outside this device."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Suggestions are unverified review-only proposals. No AI suggestion changes a file or folder automatically."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AiSetupReadinessText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="Interface complexity" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Show advanced features"
                              IsChecked="{Binding Draft.ShowAdvancedFeatures, Mode=TwoWay}" />
                    <TextBlock Text="Shows specialist comparison, diagnostics, operation-history, logging, AI request diagnostics, and troubleshooting controls. Hidden values remain saved."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsAdvancedSettingsVisible}"
                    Padding="12"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Advanced diagnostics and logging" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Enable local daily diagnostic logging" IsChecked="{Binding Draft.FileLoggingEnabled, Mode=TwoWay}" />
                    <TextBlock Text="Diagnostic log folder" FontWeight="SemiBold" />
                    <TextBox PlaceholderText="Optional absolute log directory" Text="{Binding Draft.LogDirectoryPath, Mode=TwoWay}" />
                    <TextBlock Text="{Binding DailyLogRetentionLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DailyLogRetentionDescription}" TextWrapping="Wrap" />
                    <TextBox PlaceholderText="At least 1" Text="{Binding Draft.RetainedFileCount, Mode=TwoWay}" />
                    <TextBlock Text="{Binding DailyLogRetentionValidation}" TextWrapping="Wrap" />
                    <TextBlock Text="Minimum diagnostic detail level" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding AvailableLogLevels}" SelectedItem="{Binding Draft.MinimumLogLevel, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsAdvancedSettingsVisible}"
                    Padding="12"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Advanced diagnostics" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Enable diagnostics"
                              IsChecked="{Binding Draft.DiagnosticsEnabled, Mode=TwoWay}" />
                    <TextBlock Text="Detailed sessions are bounded, retained only in memory, and displayed in one shared non-modal viewer. Disabling and saving clears all retained sessions."
                               TextWrapping="Wrap" />
                    <StackPanel IsEnabled="{Binding Draft.DiagnosticsEnabled}" Spacing="6">
                        <CheckBox Content="AI diagnostics"
                                  IsChecked="{Binding Draft.AiDiagnosticsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="OCR and text extraction diagnostics"
                                  IsChecked="{Binding Draft.OcrAndTextExtractionDiagnosticsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="Scanning diagnostics"
                                  IsChecked="{Binding Draft.ScanningDiagnosticsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="Duplicate detection diagnostics — not yet instrumented"
                                  IsChecked="{Binding Draft.DuplicateDetectionDiagnosticsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="Search and indexing diagnostics — not yet instrumented"
                                  IsChecked="{Binding Draft.SearchAndIndexingDiagnosticsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="Rules and organisation diagnostics — not yet instrumented"
                                  IsChecked="{Binding Draft.RulesAndOrganisationDiagnosticsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="File operation diagnostics — not yet instrumented"
                                  IsChecked="{Binding Draft.FileOperationDiagnosticsEnabled, Mode=TwoWay}" />
                        <CheckBox Content="Performance diagnostics — not yet instrumented"
                                  IsChecked="{Binding Draft.PerformanceDiagnosticsEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Duplicate detection, search and indexing, rules and organisation, file operations, and standalone performance sessions are planned extension points; their switches do not collect detailed sessions in this release."
                                   TextWrapping="Wrap" />
                        <CheckBox Content="Show unredacted diagnostic content"
                                  IsChecked="{Binding Draft.ShowUnredactedDiagnosticContent, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="Privacy: unredacted diagnostics may contain filenames, complete paths, extracted document text, OCR output, metadata, tags, search terms, AI prompts, and AI responses. Secrets, credentials, and authorization headers are always removed, and detailed content is never written to normal logs."
                               IsVisible="{Binding Draft.ShowUnredactedDiagnosticContent}"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsAdvancedAiSettingsVisible}"
                    Padding="12"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Local AI review history" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Use locally recorded review decisions as concise preference context"
                              IsChecked="{Binding Draft.PreferenceAdaptationEnabled, Mode=TwoWay}" />
                    <WrapPanel>
                        <Button Margin="0,0,8,8" Content="Reset local decision history" Command="{Binding RequestPreferenceHistoryResetCommand}" />
                        <Button Margin="0,0,8,8" IsVisible="{Binding IsPreferenceHistoryResetPending}" Content="Confirm decision-history reset" Command="{Binding ConfirmPreferenceHistoryResetCommand}" />
                        <Button Margin="0,0,8,8" IsVisible="{Binding IsPreferenceHistoryResetPending}" Content="Cancel reset" Command="{Binding CancelPreferenceHistoryResetCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <views:PluginsView DataContext="{Binding Plugins}" />
            </Border>

            <TextBlock Text="Restart required only to apply active logging changes."
                       IsVisible="{Binding RestartRequired}"
                       TextWrapping="Wrap" />
            <WrapPanel>
                <Button Margin="0,0,8,8" Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" />
                <Button Margin="0,0,8,8" Content="Discard changes" Command="{Binding CancelCommand}" />
                <Button Margin="0,0,8,8" Content="Save" Command="{Binding SaveCommand}" />
            </WrapPanel>
            <views:StatusBanner DataContext="{Binding Status}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
