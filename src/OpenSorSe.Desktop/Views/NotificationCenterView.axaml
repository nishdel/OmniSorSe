<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSorSe.Desktop.ViewModels"
             x:Class="OpenSorSe.Desktop.Views.NotificationCenterView"
             x:DataType="vm:NotificationCenterViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    </UserControl.KeyBindings>
    <Grid RowDefinitions="Auto,Auto" RowSpacing="6"
          IsVisible="{Binding HasNotifications}">
        <Button HorizontalAlignment="Right"
                Content="{Binding BadgeText}"
                Command="{Binding ToggleCommand}"
                AutomationProperties.Name="{Binding BadgeAutomationText}"
                ToolTip.Tip="Open or close transient notifications" />
        <Border Grid.Row="1"
                Padding="10"
                Background="{DynamicResource ThemeControlHighlightMidBrush}"
                CornerRadius="4"
                IsVisible="{Binding IsOpen}"
                AutomationProperties.Name="Notification drawer"
                AutomationProperties.LiveSetting="Polite">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Classes="secondary"
                            Content="×"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.Name="Close notifications" />
                </Grid>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Notifications}"
                         SelectedItem="{Binding SelectedNotification, Mode=TwoWay}"
                         MaxHeight="240"
                         AutomationProperties.Name="Notification list">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationMessage">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,4">
                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                                <Button Grid.Column="2"
                                        Classes="secondary"
                                        Content="Dismiss"
                                        Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Severity, StringFormat='Dismiss {0} notification'}"
                                        x:CompileBindings="False" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="Dismissing this list does not remove Advanced Diagnostics evidence."
                               TextWrapping="Wrap"
                               Classes="page-subtitle" />
                    <Button Grid.Column="1"
                            Classes="secondary"
                            Content="Clear all"
                            Command="{Binding ClearAllCommand}"
                            AutomationProperties.Name="Dismiss all transient notifications" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
