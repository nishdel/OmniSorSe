<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSorSe.Desktop.ViewModels"
             xmlns:watching="using:OpenSorSe.Application.Watching"
             x:Class="OpenSorSe.Desktop.Views.WatchedFoldersView"
             x:DataType="vm:WatchedFoldersViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Classes="page-title" Text="Watched Folders" />
                <TextBlock Classes="page-subtitle"
                           Text="Automatic detection and analysis with manual review before any file change." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Grid.Row="1"
                Classes="card"
                Padding="14">
            <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Add watched folder" />
                    <TextBox PlaceholderText="Absolute folder path"
                             Text="{Binding FolderPath}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="Display name" />
                    <TextBox PlaceholderText="Optional friendly name"
                             Text="{Binding DisplayName}" />
                </StackPanel>
                <Button Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Content="Add watched folder"
                        Command="{Binding AddFolderCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="1.05*,1.3*"
              ColumnSpacing="14">
            <Grid RowDefinitions="*,Auto" RowSpacing="8">
                <ListBox ItemsSource="{Binding Folders}"
                         SelectedItem="{Binding SelectedFolder}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:WatchedFolderRow">
                            <Border Classes="card" Padding="12" Margin="0,0,0,8">
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   Text="{Binding StateText}" />
                                    </Grid>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding FolderPath}"
                                               TextTrimming="CharacterEllipsis" />
                                    <WrapPanel>
                                        <TextBlock Margin="0,0,10,0" Text="{Binding AvailabilityText}" />
                                        <TextBlock Margin="0,0,10,0" Text="{Binding QueueText}" />
                                        <TextBlock Text="{Binding PendingPlanText}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <TextBlock IsVisible="{Binding HasError}"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               Text="{Binding Error}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <Border Classes="card" Padding="14" IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="9">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Monitoring and scan actions" />
                            <WrapPanel>
                                <Button Margin="0,0,6,6"
                                        Content="Pause"
                                        Command="{Binding PauseCommand}" />
                                <Button Margin="0,0,6,6"
                                        Content="Resume"
                                        Command="{Binding ResumeCommand}" />
                                <Button Margin="0,0,6,6"
                                        Content="Scan changes now"
                                        Command="{Binding ScanChangesNowCommand}" />
                                <Button Margin="0,0,6,6"
                                        Content="Full reconciliation"
                                        Command="{Binding FullReconciliationCommand}" />
                                <Button Margin="0,0,6,6"
                                        Classes="secondary"
                                        Content="Review suggestions"
                                        Command="{Binding ReviewSuggestionsCommand}" />
                                <Button Margin="0,0,6,6"
                                        Classes="secondary"
                                        Content="Retry failed AI analysis"
                                        Command="{Binding RetryAiCommand}" />
                                <Button Margin="0,0,6,6"
                                        Classes="secondary"
                                        Content="Open folder"
                                        Command="{Binding OpenFolderCommand}" />
                            </WrapPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Last detected change" />
                                    <TextBlock Text="{Binding SelectedFolder.LastDetectedText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="Last incremental scan" />
                                    <TextBlock Text="{Binding SelectedFolder.LastScanText}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock FontWeight="SemiBold" Text="Last full reconciliation" />
                            <TextBlock Text="{Binding SelectedFolder.LastReconciliationText}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="14" IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Watched-folder settings" />
                            <TextBlock Text="Folder path" FontWeight="SemiBold" />
                            <TextBox Text="{Binding FolderPath}" IsReadOnly="True" />
                            <TextBlock Text="Display name" FontWeight="SemiBold" />
                            <TextBox Text="{Binding DisplayName}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Text="Scan profile" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ScanProfileId}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Sorting recipe (optional)" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SortingRecipeId}"
                                             PlaceholderText="current" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Include subfolders"
                                      IsChecked="{Binding IncludeSubfolders}" />
                            <CheckBox Content="Run deterministic analysis"
                                      IsChecked="{Binding DeterministicAnalysisEnabled}" />
                            <CheckBox Content="Allow optional AI analysis for changed items"
                                      IsChecked="{Binding AiAnalysisEnabled}" />
                            <CheckBox Content="Ignore hidden files"
                                      IsChecked="{Binding IgnoreHiddenFiles}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Text="Notification level" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding NotificationLevels}"
                                              SelectedItem="{Binding NotificationLevel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox Content="Notify when a Change Plan is ready"
                                              IsChecked="{Binding NotifyWhenPlanReady}" />
                                    <CheckBox Content="Notify when the folder is unavailable"
                                              IsChecked="{Binding NotifyWhenUnavailable}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Text="Quiet period (seconds)" FontWeight="SemiBold" />
                                    <NumericUpDown Minimum="0.25"
                                                   Maximum="300"
                                                   Increment="0.25"
                                                   Value="{Binding QuietPeriodSeconds}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Maximum file size (MiB)" FontWeight="SemiBold" />
                                    <NumericUpDown Minimum="1"
                                                   Maximum="1048576"
                                                   Increment="1"
                                                   Value="{Binding MaximumFileSizeMiB}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Ignored paths (one per line)" FontWeight="SemiBold" />
                            <TextBox AcceptsReturn="True"
                                     MinHeight="64"
                                     Text="{Binding IgnoredPathsText}" />
                            <TextBlock Text="Additional ignore patterns (one per line)" FontWeight="SemiBold" />
                            <TextBox AcceptsReturn="True"
                                     MinHeight="64"
                                     PlaceholderText="Examples: *.bak or Archive/**"
                                     Text="{Binding IgnorePatternsText}" />
                            <Button HorizontalAlignment="Left"
                                    Content="Save watched-folder settings"
                                    Command="{Binding SaveSettingsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="14" IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Recent watched-folder activity" />
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="watching:WatchedActivityEntry">
                                        <Grid ColumnDefinitions="120,*" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Kind}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Summary}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="14" IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Remove from watch list" />
                            <TextBlock Text="This removes only the watched-folder configuration. The real folder, files, saved catalogue, and history are preserved."
                                       TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left"
                                    Classes="secondary"
                                    Content="Remove from watch list"
                                    Command="{Binding RequestRemoveCommand}" />
                            <StackPanel IsVisible="{Binding IsRemoveConfirmationPending}" Spacing="6">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Confirm configuration removal?" />
                                <WrapPanel>
                                    <Button Margin="0,0,6,0"
                                            Content="Confirm remove from watch list"
                                            Command="{Binding ConfirmRemoveCommand}" />
                                    <Button Classes="secondary"
                                            Content="Cancel"
                                            Command="{Binding CancelRemoveCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
