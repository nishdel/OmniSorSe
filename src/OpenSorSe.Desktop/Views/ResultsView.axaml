<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSorSe.Desktop.ViewModels"
             xmlns:ai="using:OpenSorSe.Application.AI"
             xmlns:content="using:OpenSorSe.Application.Content"
             xmlns:workflows="using:OpenSorSe.Application.Workflows"
             xmlns:views="using:OpenSorSe.Desktop.Views"
             x:Class="OpenSorSe.Desktop.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding DuplicateReview.CloseDrawerCommand}" />
    </UserControl.KeyBindings>

    <Grid>
        <Grid IsVisible="{Binding IsExplorerVisible}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Classes="page-title" Text="Files" />
                    <TextBlock Classes="page-subtitle"
                               Text="Review, search and organize your digital life." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="secondary"
                            Content="Duplicates"
                            Command="{Binding OpenDuplicateReviewCommand}"
                            IsEnabled="{Binding CanOpenDuplicateReview}"
                            ToolTip.Tip="Review exact copies from this scan." />
                    <Button Classes="help"
                            Content="?"
                            Command="{Binding HelpCommand}"
                            ToolTip.Tip="Files help. This page never changes files automatically."
                            AutomationProperties.Name="Help for Files" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    IsVisible="{Binding IsDiscoveryContextActive}"
                    Classes="subtle-card"
                    AutomationProperties.Name="Preserved discovery context">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Discovery context preserved" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DiscoveryContextText}" TextWrapping="Wrap" Classes="page-subtitle" />
                        <TextBlock IsVisible="{Binding IsContinuousReviewActive}"
                                   Text="{Binding ReviewPositionText}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Margin="0,0,6,0" IsVisible="{Binding IsContinuousReviewActive}"
                                Classes="secondary" Content="Previous" Command="{Binding PreviousReviewItemCommand}"
                                AutomationProperties.Name="Previous unresolved Smart Tag review item" />
                        <Button Margin="0,0,6,0" IsVisible="{Binding IsContinuousReviewActive}"
                                Classes="secondary" Content="Next" Command="{Binding NextReviewItemCommand}"
                                AutomationProperties.Name="Next unresolved Smart Tag review item" />
                        <Button Classes="primary" Content="Return to discovery" Command="{Binding ReturnToDiscoveryCommand}"
                                AutomationProperties.Name="Return to preserved Search, facets, and Saved View" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="card" AutomationProperties.Name="Files search and filters">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox PlaceholderText="Search file names, folders, types, or tags"
                                 Text="{Binding QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Name and metadata search" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="Search"
                                Command="{Binding OpenMeaningSearchCommand}"
                                ToolTip.Tip="{Binding MeaningSearchAvailabilityText}" />
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="Filters"
                                Command="{Binding ToggleFiltersCommand}" />
                        <ComboBox Grid.Column="3"
                                  Width="150"
                                  ItemsSource="{Binding AvailableSortFields}"
                                  SelectedItem="{Binding SelectedSortField, Mode=TwoWay}"
                                  AutomationProperties.Name="Sort files" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding PageRangeText}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="1" Classes="drawer" IsVisible="{Binding AreFiltersVisible}">
                        <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding AvailableDuplicateFilters}"
                                      SelectedItem="{Binding SelectedDuplicateFilter, Mode=TwoWay}"
                                      AutomationProperties.Name="Duplicate filter" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ExtensionOptions}"
                                      SelectedItem="{Binding SelectedExtensionOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultsExtensionFilterOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategoryOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultsCategoryFilterOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding AvailablePlannedOperationFilters}"
                                      SelectedItem="{Binding SelectedPlannedOperationFilter, Mode=TwoWay}" />
                            <Button Grid.Column="4"
                                    Classes="secondary"
                                    Content="Clear"
                                    Command="{Binding ClearFiltersCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="FilesSplitGrid"
                  Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="450" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" MinWidth="320" />
                </Grid.ColumnDefinitions>
                <Grid RowDefinitions="*,Auto,Auto" RowSpacing="10">
                    <Border Classes="card">
                        <Grid>
                            <StackPanel IsVisible="{Binding HasNoSnapshot}"
                                        Classes="empty-state"
                                        Spacing="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="○"
                                           FontSize="32"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="No files yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Scan a folder to see its files here."
                                           Classes="page-subtitle" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsEmptyCompletedScan}"
                                        Classes="empty-state"
                                        Spacing="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="✓"
                                           FontSize="30"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="No files found" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="This scan completed without finding any files."
                                           Classes="page-subtitle" />
                            </StackPanel>
                            <Grid IsVisible="{Binding HasSnapshot}"
                                  Grid.IsSharedSizeScope="True"
                                  RowDefinitions="Auto,Auto,*"
                                  RowSpacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="100" SharedSizeGroup="FilesName" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="3*" MinWidth="130" SharedSizeGroup="FilesFolder" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" MinWidth="50" SharedSizeGroup="FilesType" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" MinWidth="60" SharedSizeGroup="FilesSize" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="2*" MinWidth="70" SharedSizeGroup="FilesTags" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="6,0" Text="Name" FontWeight="SemiBold" />
                                    <GridSplitter Grid.Column="1"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext"
                                                  KeyboardIncrement="12"
                                                  DragIncrement="2"
                                                  Cursor="SizeWestEast"
                                                  Background="{DynamicResource BorderSubtleBrush}"
                                                  Focusable="True"
                                                  AutomationProperties.Name="Resize name and folder columns" />
                                    <TextBlock Grid.Column="2" Margin="6,0" Text="Folder" FontWeight="SemiBold" />
                                    <GridSplitter Grid.Column="3"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext"
                                                  KeyboardIncrement="12"
                                                  DragIncrement="2"
                                                  Cursor="SizeWestEast"
                                                  Background="{DynamicResource BorderSubtleBrush}"
                                                  Focusable="True"
                                                  AutomationProperties.Name="Resize folder and type columns" />
                                    <TextBlock Grid.Column="4" Margin="6,0" Text="Type" FontWeight="SemiBold" />
                                    <GridSplitter Grid.Column="5"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext"
                                                  KeyboardIncrement="12"
                                                  DragIncrement="2"
                                                  Cursor="SizeWestEast"
                                                  Background="{DynamicResource BorderSubtleBrush}"
                                                  Focusable="True"
                                                  AutomationProperties.Name="Resize type and size columns" />
                                    <TextBlock Grid.Column="6" Margin="6,0" Text="Size" FontWeight="SemiBold" />
                                    <GridSplitter Grid.Column="7"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="PreviousAndNext"
                                                  KeyboardIncrement="12"
                                                  DragIncrement="2"
                                                  Cursor="SizeWestEast"
                                                  Background="{DynamicResource BorderSubtleBrush}"
                                                  Focusable="True"
                                                  AutomationProperties.Name="Resize size and tags columns" />
                                    <TextBlock Grid.Column="8" Margin="6,0" Text="Tags" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding OrganizationSelectionText}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <Button Grid.Column="1"
                                            Classes="primary"
                                            Content="Organize selected"
                                            Command="{Binding OrganizeSelectedFilesCommand}"
                                            AutomationProperties.Name="Preview selected files with an Organization recipe" />
                                </Grid>
                                <ListBox Grid.Row="2"
                                         Classes="files-table"
                                         ItemsSource="{Binding PageRows}"
                                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                         SelectionMode="Multiple"
                                         SelectionChanged="OnFilesSelectionChanged"
                                         AutomationProperties.Name="Files">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ResultsFileRow">
                                            <Border Classes="result-row" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MinWidth="100" SharedSizeGroup="FilesName" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="3*" MinWidth="130" SharedSizeGroup="FilesFolder" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="Auto" MinWidth="50" SharedSizeGroup="FilesType" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="Auto" MinWidth="60" SharedSizeGroup="FilesSize" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="2*" MinWidth="70" SharedSizeGroup="FilesTags" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="6,0"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding FullPath}" />
                                                    <TextBlock Grid.Column="2"
                                                               Margin="6,0"
                                                               Text="{Binding FullPath}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding FullPath}" />
                                                    <TextBlock Grid.Column="4" Margin="6,0" Text="{Binding Extension}" />
                                                    <TextBlock Grid.Column="6" Margin="6,0" Text="{Binding Size}" />
                                                    <TextBlock Grid.Column="8"
                                                               Margin="6,0"
                                                               Text="{Binding Tags}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding MatchExplanation}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Button Classes="secondary" Content="Previous" Command="{Binding PreviousPageCommand}" />
                        <TextBlock Text="{Binding PageRangeText}" VerticalAlignment="Center" />
                        <Button Classes="secondary" Content="Next" Command="{Binding NextPageCommand}" />
                    </StackPanel>
                    <Expander Grid.Row="2"
                              IsVisible="{Binding HasWarnings}"
                              Header="Scan notes">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Grid>

                <GridSplitter x:Name="FilesDetailsSplitter"
                              Grid.Column="1"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              KeyboardIncrement="16"
                              DragIncrement="2"
                              Cursor="SizeWestEast"
                              Background="{DynamicResource AccentPrimaryMutedBrush}"
                              Focusable="True"
                              DragCompleted="OnFilesDetailsSplitterDragCompleted"
                              ToolTip.Tip="Drag or use the arrow keys to resize selected-file details."
                              AutomationProperties.Name="Resize file list and selected-file details">
                    <GridSplitter.ContextMenu>
                        <ContextMenu x:DataType="vm:ResultsViewModel">
                            <MenuItem Header="Narrow details"
                                      Command="{Binding NarrowDetailsPanelCommand}" />
                            <MenuItem Header="Widen details"
                                      Command="{Binding WidenDetailsPanelCommand}" />
                            <Separator />
                            <MenuItem Header="Reset details width"
                                      Command="{Binding ResetDetailsPanelWidthCommand}" />
                        </ContextMenu>
                    </GridSplitter.ContextMenu>
                </GridSplitter>

                <Border Grid.Column="2"
                        Classes="side-panel"
                        IsVisible="{Binding HasSelectedDetails}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Selected file" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedDetails.FileName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedDetails.FullPath}"
                                           Classes="page-subtitle"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedDetails.Classification}" />
                                <TextBlock Text="{Binding SelectedDetails.DuplicateStatus}" />
                            </StackPanel>
                            <Border Classes="separator" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="Smart Tags" FontWeight="SemiBold" />
                                <WrapPanel AutomationProperties.Name="Selected file Smart Tag summary">
                                    <ItemsControl ItemsSource="{Binding SmartTagPreview}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ResultTagRow">
                                                <Border Classes="tag-chip"
                                                        Margin="0,0,5,5"
                                                        ToolTip.Tip="{Binding Explanation}"
                                                        AutomationProperties.Name="{Binding AccessibleName}">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="tag-chip"
                                            Margin="0,0,5,5"
                                            IsVisible="{Binding HasAdditionalSmartTags}"
                                            AutomationProperties.Name="Additional Smart Tags are available in the review list">
                                        <TextBlock Text="{Binding AdditionalSmartTagText}" />
                                    </Border>
                                </WrapPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding UserTagText, Mode=TwoWay}"
                                             PlaceholderText="Add your local tags"
                                             AutomationProperties.Name="Add user tags" />
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Content="Add"
                                            Command="{Binding AddUserTagsCommand}" />
                                </Grid>
                                <ListBox ItemsSource="{Binding UserTags}"
                                         SelectedItem="{Binding SelectedUserTag, Mode=TwoWay}"
                                         MaxHeight="110">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ResultTagRow">
                                            <StackPanel Margin="0,2"
                                                        AutomationProperties.Name="{Binding AccessibleName}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           ToolTip.Tip="{Binding Explanation}" />
                                                <TextBlock Text="{Binding Category}"
                                                           Classes="page-subtitle" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Expander IsVisible="{Binding SelectedUserTag}"
                                          Header="Why this classification?"
                                          AutomationProperties.Name="Smart Tag confidence and bounded evidence">
                                    <StackPanel Margin="0,6,0,0" Spacing="3">
                                        <TextBlock Text="{Binding SelectedUserTag.Source, StringFormat='State: {0}'}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedUserTag.Explanation}" TextWrapping="Wrap" />
                                        <TextBlock Text="Evidence is bounded to the strongest local reasons. Confidence bands are not probabilities."
                                                   Classes="page-subtitle" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                                 <Button Classes="secondary"
                                         Content="Remove selected tag"
                                         Command="{Binding RemoveSelectedTagCommand}"
                                         HorizontalAlignment="Left" />
                                <WrapPanel>
                                    <Button Margin="0,0,6,0"
                                            Classes="secondary"
                                            Content="Accept suggestion"
                                            Command="{Binding AcceptSuggestedTagCommand}"
                                            AutomationProperties.Name="Accept selected Smart Tag suggestion and keep this user decision" />
                                    <Button Classes="secondary"
                                            Content="Reject suggestion"
                                            Command="{Binding RejectSuggestedTagCommand}"
                                            AutomationProperties.Name="Reject selected Smart Tag suggestion and continue review" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Margin="0,0,6,6"
                                            Classes="secondary"
                                            Content="View files with this tag"
                                            Command="{Binding ViewFilesWithTagCommand}" />
                                    <Button Margin="0,0,6,6"
                                            Classes="secondary"
                                            Content="Reset tag decisions"
                                            Command="{Binding ResetTagDecisionsCommand}"
                                            ToolTip.Tip="Allow local classifiers to reconsider accepted or dismissed Smart Tags." />
                                    <Button Margin="0,0,0,6"
                                            Classes="secondary"
                                            Content="Clear generated Smart Tags"
                                            Command="{Binding ClearGeneratedSmartTagsCommand}"
                                            ToolTip.Tip="Remove generated classifications while preserving your tags and decisions." />
                                </WrapPanel>
                                <TextBlock Text="{Binding UserTagStatusText}"
                                           Classes="page-subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Expander Header="File details">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding ContentDetailsStatus}" TextWrapping="Wrap" />
                                    <ItemsControl IsVisible="{Binding HasContentMetadata}"
                                                  ItemsSource="{Binding ContentMetadata}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="content:ExtractedMetadataField">
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <Border IsVisible="{Binding Organization.IsVisible}"
                                    Classes="card">
                                <StackPanel DataContext="{Binding Organization}"
                                            x:DataType="vm:ReviewedOrganizationViewModel"
                                            Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Organization recipe" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="Deterministic preview → Review Changes → existing Change Plan"
                                                       Classes="page-subtitle" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="Close"
                                                Command="{Binding CloseCommand}"
                                                AutomationProperties.Name="Close Organization recipe preview" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedCountText}" />
                                    <ComboBox ItemsSource="{Binding AvailableRecipes}"
                                              SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                                              AutomationProperties.Name="Organization recipe" />
                                    <TextBlock Text="Naming pattern" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding NamingPattern, Mode=TwoWay}"
                                             AutomationProperties.Name="Organization recipe naming pattern" />
                                    <TextBlock Text="Destination pattern inside the indexed source" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding DestinationPattern, Mode=TwoWay}"
                                             AutomationProperties.Name="Organization recipe relative destination pattern" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding TokenTargets}"
                                                  SelectedItem="{Binding TokenTarget, Mode=TwoWay}"
                                                  AutomationProperties.Name="Recipe token insertion target" />
                                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding AvailableTokens}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="workflows:OrganizationRecipeToken">
                                                        <Button Margin="0,0,6,0" Classes="secondary"
                                                                Content="{Binding DisplayName}"
                                                                ToolTip.Tip="{Binding Description}"
                                                                Command="{Binding DataContext.Organization.InsertTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding AccessibleName}"
                                                                x:CompileBindings="False" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Margin="0,0,6,6" Classes="primary" Content="Preview recipe"
                                                Command="{Binding PreviewCommand}" />
                                        <Button Margin="0,0,6,6" Classes="secondary" Content="Cancel preview"
                                                IsVisible="{Binding IsBusy}" Command="{Binding CancelPreviewCommand}" />
                                        <Button Margin="0,0,6,6" Classes="secondary" Content="Manage recipes"
                                                Command="{Binding ManageRecipesCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{Binding CoverageText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ActionCountText}" TextWrapping="Wrap" />
                                    <Border IsVisible="{Binding HasSensitivePathWarning}" Classes="subtle-card">
                                        <TextBlock Text="{Binding PrivacyWarningText}" TextWrapping="Wrap"
                                                   AutomationProperties.Name="Classification externalization warning" />
                                    </Border>
                                    <StackPanel IsVisible="{Binding HasProposal}" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding PreviewRangeText}" TextWrapping="Wrap" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding PreviewFilters}"
                                                      SelectedItem="{Binding PreviewFilter, Mode=TwoWay}"
                                                      AutomationProperties.Name="Organization preview readiness filter" />
                                        </Grid>
                                        <ListBox ItemsSource="{Binding VisibleRows}" MaxHeight="360"
                                                 AutomationProperties.Name="Bounded Organization proposal preview">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OrganizationProposalRowViewModel">
                                                    <Border Classes="result-row" Padding="0,7">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{Binding Readiness}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding CurrentPath, StringFormat='Current: {0}'}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding TargetPath, StringFormat='Proposed: {0}'}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding EvidenceText}" Classes="page-subtitle" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{Binding RecommendationText}" Classes="page-subtitle" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Margin="0,0,6,0" Classes="secondary" Content="Exclude files that cannot be proposed"
                                                    Command="{Binding RemoveUnreadyCommand}" />
                                            <Button Classes="primary" Content="Review Changes"
                                                    Command="{Binding ReviewChangesCommand}"
                                                    AutomationProperties.HelpText="Revalidates this preview, then creates the existing Change Plan. No file operation runs yet." />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border IsVisible="{Binding AiSuggestions.IsVisible}"
                                    Classes="ai-card">
                                <StackPanel Spacing="7"
                                            DataContext="{Binding AiSuggestions}"
                                            x:DataType="vm:AiSuggestionsViewModel">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Organize selected files" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="Suggest → Review Changes → execute; nothing is changed automatically"
                                                       Classes="page-subtitle" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="help"
                                                Content="?"
                                                Command="{Binding HelpCommand}"
                                                ToolTip.Tip="Suggestions never rename or move files automatically." />
                                    </Grid>
                                    <TextBlock Text="{Binding ReadinessText}" TextWrapping="Wrap" />
                                    <Button Classes="secondary"
                                            Content="Retry connection"
                                            Command="{Binding RetryConnectionCommand}" />
                                    <Border IsVisible="{Binding IsFileRenameVisible}" Classes="subtle-card">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Rename Helper" FontWeight="SemiBold" />
                                            <Button Classes="primary"
                                                    Content="Suggest a name"
                                                    Command="{Binding GenerateSuggestionCommand}"
                                                    ToolTip.Tip="{Binding RenameActionAvailabilityText}" />
                                            <TextBlock Text="{Binding RenameActionAvailabilityText}"
                                                       Classes="page-subtitle"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding OrganizationEvidenceText}"
                                                       Classes="page-subtitle"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="Grounded classification evidence permitted for the rename suggestion" />
                                            <StackPanel IsVisible="{Binding HasRenameSuggestion}" Spacing="4">
                                                <TextBox Text="{Binding ProposedFileName, Mode=TwoWay}" />
                                                <TextBlock Text="{Binding RenameReason}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RenameConfidenceText}"
                                                           Classes="page-subtitle"
                                                           TextWrapping="Wrap" />
                                                <WrapPanel>
                                                    <Button Margin="0,0,6,0"
                                                            Classes="primary"
                                                            Content="Keep proposal"
                                                            Command="{Binding AcceptRenameCommand}" />
                                                    <Button Classes="secondary"
                                                            Content="Dismiss"
                                                            Command="{Binding RejectRenameCommand}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Expander IsVisible="{Binding IsFolderStructureVisible}"
                                              Header="Folder suggestion">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding FolderStructureContextText}"
                                                       Classes="page-subtitle"
                                                       TextWrapping="Wrap" />
                                            <Button Classes="secondary"
                                                    Content="Suggest a folder plan"
                                                    Command="{Binding GenerateFolderStructureCommand}" />
                                            <TextBlock Text="{Binding FolderStructureReason}" TextWrapping="Wrap" />
                                            <ItemsControl IsVisible="{Binding HasFolderStructurePlan}"
                                                          ItemsSource="{Binding StructureItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="ai:AiFolderStructurePlanItem">
                                                        <TextBlock Text="{Binding DestinationFolder}"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="AI request context">
                                        <TextBox Text="{Binding AiRequestContextText}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas, Cascadia Mono, monospace" />
                                    </Expander>
                                    <Expander IsVisible="{Binding IsDocumentInterpretationVisible}"
                                              Header="Document summary">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Uses extracted local text only after you request it. The result is unverified."
                                                       Classes="page-subtitle"
                                                       TextWrapping="Wrap" />
                                            <Button Classes="secondary"
                                                    Content="Suggest document details"
                                                    Command="{Binding GenerateDocumentInterpretationCommand}" />
                                            <TextBlock IsVisible="{Binding HasDocumentInterpretation}"
                                                       Text="{Binding DocumentInterpretationSummary}"
                                                       TextWrapping="Wrap" />
                                            <Button IsVisible="{Binding HasDocumentInterpretation}"
                                                    Classes="secondary"
                                                    Content="Dismiss"
                                                    Command="{Binding DismissDocumentInterpretationCommand}" />
                                        </StackPanel>
                                    </Expander>
                                    <Button IsVisible="{Binding IsBusy}"
                                            Classes="secondary"
                                            Content="Cancel suggestion"
                                            Command="{Binding CancelAiOperationCommand}" />
                                    <views:StatusBanner DataContext="{Binding Status}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

            <Grid IsVisible="{Binding IsDuplicateReviewVisible}">
                <Grid DataContext="{Binding DuplicateReview}"
                      x:DataType="vm:DuplicateReviewViewModel"
                      x:Name="DuplicateViewRoot"
                      RowDefinitions="Auto,Auto,*"
                      RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="3">
                    <TextBlock Classes="page-title" Text="Duplicates" />
                    <TextBlock Classes="page-subtitle"
                               Text="Spot identical copies before cleaning." />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="secondary"
                        Content="Back to Files"
                        Command="{Binding BackToExplorerCommand}" />
                <Button Grid.Column="2"
                        Classes="help"
                        Content="?"
                        Command="{Binding HelpCommand}" />
                </Grid>
            <TextBox Grid.Row="1"
                     PlaceholderText="Filter copies by name, folder, type, or category"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Filter duplicate groups" />
            <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="12">
                <Border Classes="card">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBlock Text="Copies spotted" FontSize="18" FontWeight="SemiBold" />
                        <views:StatusBanner Grid.Row="1" DataContext="{Binding Status}" />
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding VisibleGroupRows}"
                                 SelectedItem="{Binding SelectedGroupRow, Mode=TwoWay}"
                                 AutomationProperties.Name="Duplicate groups">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DuplicateReviewGroupRow">
                                    <StackPanel Margin="0,5" Spacing="2">
                                        <TextBlock Text="{Binding Group.Ordinal, StringFormat=Group {0}}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Group.MemberCount, StringFormat={}{0} identical files}" />
                                        <TextBlock Text="{Binding CommonFileSize, StringFormat=Each file: {0}}" />
                                        <TextBlock Text="{Binding MemberSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Column="1"
                        IsVisible="{Binding IsDrawerOpen}"
                        Classes="side-panel"
                        AutomationProperties.Name="Duplicate details">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding SelectedGroupCountText}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    Content="Close"
                                    Command="{Binding CloseDrawerCommand}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="9">
                                <TextBlock Text="Choose unwanted copies in this group, then choose other groups if needed. Review selected duplicates creates one Change Plan and never removes every known copy from any group."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedGroupPotentialReclaimableText, StringFormat=Space you could save: {0}}"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding MemberRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DuplicateFileRow">
                                            <Border Classes="result-row" Padding="0,7">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ParentPath}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SizeText}" />
                                                        <WrapPanel>
                                                            <Button Margin="0,2,8,0"
                                                                    Classes="secondary"
                                                                    Content="Open file"
                                                                    Command="{Binding DataContext.OpenFileCommand, ElementName=DuplicateViewRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    x:CompileBindings="False" />
                                                            <Button Margin="0,2,8,0"
                                                                    Classes="secondary"
                                                                    Content="Open folder"
                                                                    Command="{Binding DataContext.OpenContainingFolderCommand, ElementName=DuplicateViewRoot}"
                                                                    CommandParameter="{Binding}"
                                                                    x:CompileBindings="False" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SelectedMemberCountText}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Border Classes="notice-card">
                                    <TextBlock Text="Safe removal moves selected copies into a hidden OmniSorSe recovery area under this scan root. It does not permanently delete them or reclaim disk space immediately. A successful move is journalled and can be undone while conflict checks pass."
                                               TextWrapping="Wrap" />
                                </Border>
                                <WrapPanel>
                                    <Button Margin="0,0,8,8"
                                            Classes="primary"
                                            Content="Review selected duplicates"
                                            Command="{Binding RequestRemovalPlanCommand}"
                                            AutomationProperties.Name="Review selected duplicate removals in a Change Plan"
                                            ToolTip.Tip="Selections remain while you inspect other groups. Leave at least one copy in every affected group." />
                                    <Button IsVisible="{Binding IsCreatingRemovalPlan}"
                                            Margin="0,0,8,8"
                                            Classes="secondary"
                                            Content="Cancel plan creation"
                                            Command="{Binding CancelRemovalPlanCommand}" />
                                    <Button IsVisible="{Binding IsExactPair}"
                                            Margin="0,0,8,8"
                                            Classes="secondary"
                                            Content="Open both"
                                            Command="{Binding OpenBothFilesCommand}" />
                                    <Button IsVisible="{Binding IsLargeGroup}"
                                            Margin="0,0,8,8"
                                            Classes="secondary"
                                            Content="Open selected"
                                            Command="{Binding OpenSelectedFilesCommand}" />
                                    <Button Margin="0,0,8,8"
                                            Classes="secondary"
                                            Content="Open selected folders"
                                            Command="{Binding OpenSelectedFoldersCommand}" />
                                    <Button IsVisible="{Binding IsOpening}"
                                            Margin="0,0,8,8"
                                            Classes="secondary"
                                            Content="Cancel opening"
                                            Command="{Binding CancelOpenCommand}" />
                                    <Button Margin="0,0,8,8"
                                            Classes="primary"
                                            Content="Show in Files"
                                            Command="{Binding ShowGroupFilesCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Column="1"
                        IsVisible="{Binding !IsDrawerOpen}"
                        Classes="empty-state">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                        <TextBlock Text="⧉"
                                   FontSize="30"
                                   Foreground="{DynamicResource AccentDuplicateBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Choose a duplicate group" FontWeight="SemiBold" />
                        <TextBlock Text="Its file locations will appear here."
                                   Classes="page-subtitle" />
                    </StackPanel>
                </Border>
            </Grid>
                </Grid>
        </Grid>
    </Grid>
</UserControl>
