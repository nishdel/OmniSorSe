<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSorSe.Desktop.ViewModels"
             xmlns:executorModels="using:OpenSorSe.Executor.Models"
             x:Class="OpenSorSe.Desktop.Views.UndoHistoryView"
             x:DataType="vm:UndoHistoryViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Operation History" FontSize="24" FontWeight="SemiBold" />
                <Button Grid.Column="1" Classes="help" Content="?" Command="{Binding HelpCommand}"
                        ToolTip.Tip="Open Operation History help" AutomationProperties.Name="Help for Operation History" />
            </Grid>
            <TextBlock Text="Persistent Operation History records every attempted v1.1 file action, rollback, and Undo result."
                       TextWrapping="Wrap" />
            <Button Classes="secondary"
                    HorizontalAlignment="Left"
                    Content="Refresh history"
                    Command="{Binding RefreshCommand}" />
            <Border IsVisible="{Binding IsEmpty}"
                    Padding="12"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1">
                <TextBlock Text="{Binding EmptyStateMessage}" TextWrapping="Wrap" />
            </Border>
            <StackPanel IsVisible="{Binding HasSessions}" Spacing="8">
                <TextBlock Text="Operation-history sessions supplied for this application process" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" />
                <TextBlock Text="{Binding SelectedSession.SessionId}" />
                <TextBlock Text="{Binding SelectedSession.Records.Count, StringFormat='Operation records: {0}'}" />
            </StackPanel>
            <Grid IsVisible="{Binding HasOperations}" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="12">
                <ListBox ItemsSource="{Binding Operations}"
                         SelectedItem="{Binding SelectedOperation, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="executorModels:OperationJournalRecord">
                            <Border Padding="8" Margin="0,0,0,4"
                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding StartedAtUtc}" />
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.Column="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Operation Details" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedOperationSummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedOperation.AffectedRootFolder}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedOperationDetails}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Margin="0,0,6,0"
                                    Classes="secondary"
                                    Content="Copy operation report"
                                    Command="{Binding CopyReportCommand}" />
                            <Button Content="Undo"
                                    Command="{Binding RequestOperationUndoCommand}" />
                        </WrapPanel>
                        <WrapPanel IsVisible="{Binding IsUndoConfirmationPending}">
                            <Button Margin="0,0,6,0"
                                    Content="Confirm Undo"
                                    Command="{Binding ConfirmOperationUndoCommand}" />
                            <Button Classes="secondary"
                                    Content="Cancel"
                                    Command="{Binding CancelUndoCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
