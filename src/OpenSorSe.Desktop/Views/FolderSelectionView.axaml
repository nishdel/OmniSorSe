<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSorSe.Desktop.ViewModels"
             xmlns:workflows="using:OpenSorSe.Application.Workflows"
             x:Class="OpenSorSe.Desktop.Views.FolderSelectionView"
             x:DataType="vm:FolderSelectionViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Folder Selection" FontSize="24" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Help" Command="{Binding HelpCommand}"
                        ToolTip.Tip="Open scan-folder help" AutomationProperties.Name="Help for Scan folders" />
            </Grid>
            <TextBlock Text="Add accessible local folders, then start a read-only analysis. OmniSorSe does not modify selected files."
                       TextWrapping="Wrap" />
            <TextBlock Text="Selected folders" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding SelectedFolders}"
                     SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                     MinHeight="120" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="420"
                         PlaceholderText="Absolute folder path"
                         Text="{Binding FolderPathInput, Mode=TwoWay}" />
                <Button Content="Browse..." Click="OnBrowseClick" />
                <Button Content="Add folder" Command="{Binding AddFolderCommand}" />
                <Button Content="Remove selected" Command="{Binding RemoveSelectedFolderCommand}" />
            </StackPanel>
            <TextBlock Text="Recent locations" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding RecentFolders}" MaxHeight="100" />
            <Border Classes="card" Padding="12">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="Workflow profile" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="Refresh profiles"
                                Command="{Binding RefreshProfilesCommand}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding WorkflowProfiles}"
                              SelectedItem="{Binding SelectedWorkflowProfile}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="workflows:WorkflowProfile">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" />
                    <CheckBox Content="Use one-time constraints without changing the saved profile"
                              IsChecked="{Binding UseOneTimeOverride}" />
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10"
                          IsVisible="{Binding UseOneTimeOverride}">
                        <CheckBox Content="OCR" IsChecked="{Binding OverrideOcrEnabled}" />
                        <CheckBox Grid.Column="1" Content="Duplicates" IsChecked="{Binding OverrideDuplicateAnalysisEnabled}" />
                        <CheckBox Grid.Column="2" Content="AI" IsChecked="{Binding OverrideAiEnabled}" />
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Maximum file size (MiB)" />
                            <NumericUpDown Minimum="1" Maximum="1048576" Value="{Binding OverrideMaximumFileSizeMiB}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          IsVisible="{Binding UseOneTimeOverride}">
                        <TextBox PlaceholderText="Save adjusted configuration as a new profile"
                                 Text="{Binding NewProfileName}" />
                        <Button Grid.Column="1"
                                Content="Save as new profile"
                                Command="{Binding SaveAdjustedAsProfileCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Button Content="Start scan" Command="{Binding StartScanCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
